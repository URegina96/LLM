# Шаблон настроек: скопируйте в .env и заполните своими значениями (.env в Git не попадает)

# Ключ подписи JWT. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Langfuse: Settings → API Keys в своём проекте
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://127.0.0.1:3001

# TMDB: API Read Access Token (themoviedb.org → Settings → API)
TMDB_TOKEN=

# PostgreSQL для журнала аудита (пароль в двух строках одинаковый, без символов @ : / #)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://dorama:ПАРОЛЬ@127.0.0.1:5433/dorama
